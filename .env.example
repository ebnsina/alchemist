# Port map for local development. SeaweedFS occupies 8080 (volume), 8888
# (filer), 9000 (S3) and 9333 (master), so Alchemist must not use 8080.
# Every var here is required. The binary refuses to boot if any is missing.
ALCHEMIST_HTTP_ADDR=:8090
ALCHEMIST_DATABASE_URL=postgres://alchemist_app:alchemist@localhost:5432/alchemist?sslmode=disable
ALCHEMIST_S3_ENDPOINT=http://localhost:9000
ALCHEMIST_S3_REGION=us-east-1
ALCHEMIST_S3_BUCKET=alchemist
ALCHEMIST_S3_ACCESS_KEY=alchemist
ALCHEMIST_S3_SECRET_KEY=alchemistdev
ALCHEMIST_PLAYBACK_KEYS=k1:dev-only-playback-key-change-me-32b
# Scratch space for encodes. Sized for EncodeWorkers concurrent jobs, each holding a
# source, a mezzanine and a chunk set. Directories left by a process that died mid-job
# are swept hourly once they are older than any job can run.
ALCHEMIST_WORK_DIR=/tmp/alchemist-work
ALCHEMIST_ENCODE_WORKERS=2
ALCHEMIST_KEK=dev-only-key-encryption-key-change-me
# Local harness only: exact ip:port pairs exempt from the SSRF address guard.
# NEVER set this in production.
ALCHEMIST_FETCH_ALLOWLIST=127.0.0.1:8071,127.0.0.1:8072
# Read only by `alchemist create-admin`, never by the server: the password for the
# platform administrator being created. There is no default -- the command exits if
# it is unset. Do not put a real one in this file.
# ALCHEMIST_STAFF_PASSWORD=

# Operator credential for /admin (tenant + API key provisioning).
# Unset means the admin surface returns 404 rather than existing unprotected.
ALCHEMIST_ADMIN_KEY=dev-only-admin-key-change-me-32bytes

# Live ingest. Both the host and the pull base or neither -- one without the other
# fails at boot. Unset leaves the live endpoints unmounted.
ALCHEMIST_LIVE_INGEST_HOST=localhost
# Where the transcoder reads a published stream back from. The ingest server
# (deploy/live/mediamtx.yml) terminates SRT and RTMP and checks the stream key.
ALCHEMIST_LIVE_PULL_BASE=rtsp://127.0.0.1:8554
# Concurrent broadcasts this box accepts. Cores, not ports: one rung is roughly one
# core held for the length of the broadcast.
ALCHEMIST_LIVE_MAX_STREAMS=2

# Browser origins allowed to call the account endpoints with credentials.
# Unset means the signup and login surface is off.
ALCHEMIST_WEB_ORIGINS=http://localhost:4321,http://localhost:5173
# Cookie scope. Unset is host-only, which is what localhost wants.
ALCHEMIST_SESSION_DOMAIN=
# Set to any value to drop the Secure flag. Local http only.
ALCHEMIST_SESSION_INSECURE=1
