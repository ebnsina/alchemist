# Every var here is required. The binary refuses to boot if any is missing.
ALCHEMIST_HTTP_ADDR=:8080
ALCHEMIST_DATABASE_URL=postgres://alchemist_app:alchemist@localhost:5432/alchemist?sslmode=disable
ALCHEMIST_S3_ENDPOINT=http://localhost:9000
ALCHEMIST_S3_REGION=us-east-1
ALCHEMIST_S3_BUCKET=alchemist
ALCHEMIST_S3_ACCESS_KEY=alchemist
ALCHEMIST_S3_SECRET_KEY=alchemistdev
ALCHEMIST_PLAYBACK_KEYS=k1:dev-only-playback-key-change-me-32b
ALCHEMIST_WORK_DIR=/tmp/alchemist-work
ALCHEMIST_ENCODE_WORKERS=2
ALCHEMIST_KEK=dev-only-key-encryption-key-change-me
# Local harness only: exact ip:port pairs exempt from the SSRF address guard.
# NEVER set this in production.
ALCHEMIST_FETCH_ALLOWLIST=127.0.0.1:8071,127.0.0.1:8072
