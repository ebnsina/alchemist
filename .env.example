# Where the pages send signup, login and everything else. Baked in at build time, so
# a change here needs a rebuild. Must be an origin listed in the engine's
# ALCHEMIST_WEB_ORIGINS.
PUBLIC_ALCHEMIST_API=http://localhost:8090

# --- AI. Read at runtime, never sent to the browser. ---
# Which provider answers. No default: a deployment that forgot this should fail
# loudly at the first request rather than quietly picking one.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
# The adapter reads its own key and refuses to take one in code, so set the variable
# its provider expects: ANTHROPIC_API_KEY, or OPENAI_API_KEY for openai.
ANTHROPIC_API_KEY=

# --- adapter-node. Set by the service unit in production. ---
PORT=3000
# Required by SvelteKit behind a proxy, or form actions fail CSRF checks.
ORIGIN=https://alchemist.example
