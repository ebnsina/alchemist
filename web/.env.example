# Where the pages send signup, login and everything else. Baked in at build time, so
# a change here needs a rebuild. Must be an origin listed in the engine's
# ALCHEMIST_WEB_ORIGINS.
PUBLIC_ALCHEMIST_API=http://localhost:8090

# --- AI. Read at runtime, never sent to the browser. ---
# Which provider answers. No default: a deployment that forgot this should fail
# loudly at the first request rather than quietly picking one.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
# anthropic, openai, gemini or ollama. The adapter reads its own key and refuses to
# take one in code, so set the variable its provider expects: ANTHROPIC_API_KEY,
# OPENAI_API_KEY or GEMINI_API_KEY. Ollama runs on your own machine and needs none.
ANTHROPIC_API_KEY=

# --- Transcription. Its own provider choice, because it is its own market. ---
#
# TanStack AI ships a transcription adapter for OpenAI and not for the others: Gemini
# and Ollama do speech *generation*, which is the opposite direction. So this reads its
# own variables rather than pretending there are four options.
#
# Unset, transcription is simply off and the dashboard does not offer it.
# TRANSCRIBE_MODEL=whisper-1
#
# The self-hosted path, and the reason this is not locked to OpenAI:
# faster-whisper-server, whisper.cpp's server and several others expose an
# OpenAI-compatible /v1/audio/transcriptions. Point this at one and the audio never
# leaves your machine and costs nothing per minute. A local server usually wants no
# key, so OPENAI_API_KEY is only required when this is unset.
# TRANSCRIBE_BASE_URL=http://127.0.0.1:8000/v1

# --- adapter-node. Set by the service unit in production. ---
PORT=3000
# Required by SvelteKit behind a proxy, or form actions fail CSRF checks.
ORIGIN=https://alchemist.example
